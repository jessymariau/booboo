node_modules/
dist/
dist-app/
/build/
.env
.env.*
*.log
.DS_Store
.turbo/
coverage/
# generated snapshots may contain real/private data — never commit
*.booboo.json
# ...but DO ship the demo + test-fixture sample graphs
!examples/demo.booboo.json
!packages/build/test/fixture.booboo.json
# local verification artifacts (screenshots + smoke scripts)
*.png
# ...except the MCPB listing icon — a shipped product asset. build.mjs fails without it.
!packages/mcpb/icon.png
verify_*.py
shot_*.py

# built public site (assembled by scripts/build-web.mjs)
web/dist/
!examples/pemberton/pemberton.booboo.json
!examples/pemberton/org.pemberton.booboo.json

# Vercel CLI link (per-machine, never committed)
.vercel

# Scratch probes. An underscore prefix means throwaway: written to answer one
# question, never imported, never deployed. Named here so `git status` can stay
# empty, which is what scripts/deploy.mjs requires before it will ship.
scripts/_*.mjs
packages/*/_*.mjs
